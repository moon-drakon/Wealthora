# Copy names into your environment or secret manager. Never commit real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/wealthora
DATABASE_USERNAME=wealthora
DATABASE_PASSWORD=replace-outside-source-control
TOKEN_PEPPER=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRY=PT15M
REFRESH_TOKEN_EXPIRY=P30D
LOGIN_LOCK_DURATION=PT15M
MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
PASSWORD_RESET_EXPIRY=PT15M
PASSWORD_RESET_REQUEST_COOLDOWN=PT1M
REGISTRATION_REQUIRES_ADMIN_APPROVAL=true
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-outside-source-control
SMTP_PASSWORD=replace-outside-source-control
SMTP_FROM=no-reply@example.invalid
GOOGLE_OAUTH_CLIENT_ID=not-configured
GOOGLE_OAUTH_CLIENT_SECRET=not-configured
GOOGLE_CLOUD_PROJECT=wealthora-voice
SPEECH_MAXIMUM_AUDIO_BYTES=1000000
SPEECH_MINIMUM_AUDIO_BYTES=3200
