# Copy only the variables you need into your process environment or secret manager.
# Never place real values in this file.

# Desktop
APP_OWNER_EMAIL=owner@northsouth.edu
WEALTHORA_SERVER_URL=http://127.0.0.1:8080

# Server database and token security (required)
# Neon must use a JDBC URL with TLS, such as:
# jdbc:postgresql://HOST/DATABASE?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/wealthora
DATABASE_USERNAME=wealthora
DATABASE_PASSWORD=replace-outside-source-control
TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Server port and authentication policy
PORT=8080
REGISTRATION_REQUIRES_ADMIN_APPROVAL=false
ACCESS_TOKEN_EXPIRY=PT15M
REFRESH_TOKEN_EXPIRY=P30D
LOGIN_LOCK_DURATION=PT15M
MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
PASSWORD_RESET_EXPIRY=PT15M
PASSWORD_RESET_REQUEST_COOLDOWN=PT1M
MAXIMUM_PASSWORD_RESET_ATTEMPTS=5

# SMTP (required for production registration and password recovery)
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-outside-source-control
SMTP_PASSWORD=replace-outside-source-control
SMTP_FROM_ADDRESS=no-reply@example.invalid
SMTP_FROM_NAME=Wealthora

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback
GOOGLE_OAUTH_FLOW_EXPIRY=PT3M

# Google Cloud Speech (optional)
GOOGLE_CLOUD_PROJECT=
SPEECH_MAXIMUM_AUDIO_BYTES=1000000
SPEECH_MINIMUM_AUDIO_BYTES=3200

# Development-only mail sink; set a temporary path outside the repository.
# Never enable the dev-mail-sink profile in production.
